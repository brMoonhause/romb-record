# ROMB D5 / jet 200 — параметрична модель для FreeCAD (Macro > Macros... > Execute). Згенеровано з params.py + foils.py + geom.py + fc_build.py
"""РОМБ D5 / jet 200 — таблиця параметрів (мм). Правиш тут — модель перебудовується."""
# --- планформа (контрольні лінії) ---
LE_SWEEP_IN  = 78.0    # град, передня кромка до злому
X_CRANK      = 600.0   # x злому передньої кромки
LE_SWEEP_OUT = 40.0    # град, після злому
TE_ROOT      = 1000.0  # x задньої кромки на осі
TE_FWD_SWEEP = 10.0    # град, задня кромка стріловидна вперед
SPAN_HALF    = 400.0
# --- перерізи: (y, профіль, хорда, зміщення LE)  профілі: BODY, 0016-64, 0012-64, 0009, 0006 ---
SECTIONS = [
    (0.0,   'BODY',    1000.0,   0.0),   # повний профіль тіла, ззаду обрізається нішею на X_SLOT
    (30.0,  'BODY',     926.7,  53.0),   # = BODY-150-T72 хорда 670 / 0.723
    (60.0,  '0016-64',  707.1, 282.3),   # біля стінки ніші (було y=66)
    (80.0,  '0016-64',  569.0, 417.0),
    (127.5, '0012-64',  378.0, 600.0),
    (200.0, '0009',     304.0, 661.0),
    (340.0, '0006',     162.0, 778.0),
    (400.0, '0006',     101.0, 829.0),
]
# --- згладжування форми ---
LE_BLEND    = {30.0:14.0, 60.0:10.0, 80.0:10.0, 127.5:22.0}   # напівширина (по y) заокруглення зламів передньої кромки
N_SPAN      = 26       # перерізів на півкрило для гладкого (не лінійчатого) loft
# --- відсік двигуна: корпус і крило тягнуться до двигуна, зазор під теплоізоляцію ---
BAY_GAP     = 5.0      # радіальний зазор двигун — стінка відсіку (керамічний папір + фольга)
X_EXHAUST   = 1030.0   # канал вихлопу за соплом виходить за задню кромку
# --- повітрозабірники: вписані в товщину крила (без виступів), виїмка в передній кромці ---
MDOT        = 0.43     # кг/с, витрата повітря K-210
A_THROAT    = 1300.0   # мм², горло одного каналу (2×13 см² → M_горла 0.45 статично)
INLET_CR    = 1.10     # площа входу / площа горла
X_INLET     = 480.0    # площина входу: за шпангоутом 450, перед переходом до стріловидності 40°
LIP_T       = 4.0      # товщина губи (обшивка навколо входу)
LIP_R       = 22.0     # довжина заокруглення губи (еліптичний профіль від поверхні крила до входу)
INLET_EDGE  = 2.0      # відступ входу від передньої кромки зовні
L_INLIP     = 25.0     # вхід → горло
X_DUCT2     = 700.0    # кінець каналу всередині камери
DUCT_Y_END  = 32.0     # вісь каналу на виході (у камері)
A_DUCT_END  = 2000.0   # мм², площа каналу на виході (дифузор 1,54)
# --- камера перед двигуном: обидва канали скидають повітря в неї, з неї — у вхід двигуна ---
X_CH0       = 640.0    # передня стінка камери
R_CH        = 58.0     # радіус камери (тіло тут ~150 мм завтовшки, бокові стінки на y=±70)
DUCT_SPLIT  = 1.0      # півтовщини перегородки між каналами на осі
DUCT_WALL   = 4.0      # мінімальна стінка каналу до обшивки
N_DUCT      = 31       # перерізів каналу (рівномірно)
# --- двигун jet 200 (профіль з його моделі Fusion), сопло на X_NOZZLE ---
X_NOZZLE    = 985.0
ENGINE = [(-14.15,2),(-11.75,12.5),(-10.75,12.5),(-10.75,42.1),(-9.95,42.1),(-9.6,47),(-9.1,51),
          (-8.45,53.5),(-3.65,54.5),(2.75,54.5),(4.75,53.5),(5.65,46),(5.8,38),(7.25,36.5),(9.95,27),(9.95,0.5)]
            # (x у см у системі моделі двигуна, r у мм); зріз сопла x=9.95
# --- елевони ---
X_HINGE     = 890.0
Y_ELEV_IN   = 72.0     # внутрішній край (бокова стінка на y=70)
Y_ELEV_SPLIT= 200.0
FIN_STRIP   = 5.0      # нерухома смужка ±5 мм на y=200 за віссю шарнірів — на ній стоїть задня частина кореня кіля
HINGE_GAP   = 1.0      # щілина між крилом і елевоном
# --- кілі ---
FIN_Y       = 200.0
FIN_ROOT_LE = 765.0
FIN_ROOT_C  = 200.0
FIN_TIP_C   = 110.0
FIN_TIP_DX  = 70.0     # зсув LE на кінці
FIN_SPAN    = 90.0     # від площини крила (z=0) до кінця; відкрита висота ~80
FIN_CANT    = 5.0      # град назовні
FIN_FOIL    = '0005'
N_PTS       = 81       # точок на поверхню профілю
# --- внутрішній набір (пластини 2 мм; у моделі доходять до зовнішньої поверхні, реально — мінус обшивка 3,5 мм) ---
T_PLATE     = 2.0
KEEL        = (60.0, 615.0)                 # центральна стінка y=0: x від..до
SIDE_WEBS   = (70.0, 580.0, 884.0)          # бокові стінки y=±70: x від..до (кріплення двигуна)
FRAMES      = [(300.0,50.0),(450.0,110.0),(615.0,127.5),(723.0,127.5),(806.0,90.0)]   # (x, напівширина)
FRONT_SPAR  = ((127.5,635.0),(385.0,852.0)) # (y,x) кінці переднього лонжерона (за 35 мм від кромки)
REAR_SPAR   = (884.0, 72.0, 395.0)          # задній лонжерон (вісь шарнірів): x, y від..до
RIBS        = [127.5, 200.0, 340.0]         # нервюри (y), від переднього до заднього лонжерона
SERVOS      = [(135.0,850.0),(220.0,820.0)] # (y, x) центри сервоприводів, симетрично
SERVO_BOX   = (30.0, 30.0, 10.0)            # x, y, z — тонкий крильовий серво, лежить плазом
"""Профілі: NACA 4-digit і modified 4-digit (00tt-IT), та профіль тіла BODY-150."""
import numpy as np
D1={0.2:0.200,0.3:0.234,0.4:0.315,0.5:0.465,0.6:0.700}
def mod4_half(x,t,I,m):
    """напівтовщина modified NACA 4-digit (Ladson, NASA TM-4741), хорда 1"""
    d0=0.002; d1=D1[m]; sm=1-m
    A=np.array([[sm**2,sm**3],[2*sm,3*sm**2]]); d2,d3=np.linalg.solve(A,[0.1-d0-d1*sm,-d1])
    fpp=2*d2+6*d3*sm                       # f'' по x у точці m
    a0=0.296904*I/6
    M=np.array([[m,m*m,m**3],[1,2*m,3*m*m],[0,2,6*m]])
    rhs=[0.1-a0*np.sqrt(m),-0.5*a0/np.sqrt(m),fpp+0.25*a0*m**-1.5]
    a1,a2,a3=np.linalg.solve(M,rhs)
    x=np.asarray(x,float); y=np.where(x<m,a0*np.sqrt(x)+a1*x+a2*x**2+a3*x**3,
        d0+d1*(1-x)+d2*(1-x)**2+d3*(1-x)**3)
    return y*t/0.2
def naca4_half(x,t):
    x=np.asarray(x,float)
    return 5*t*(0.2969*np.sqrt(x)-0.1260*x-0.3516*x**2+0.2843*x**3-0.1015*x**4)
def body_half(x,t=0.15,I=6,m=0.5,hold=(0.50,0.65)):
    """BODY-150: mod4 0.15 I=6 T=0.5, плоска ділянка максимальної товщини від 0.50 до 0.65,
    задня частина стиснута на [0.65,1]"""
    x=np.asarray(x,float); h0,h1=hold
    xa=np.where(x<=h0,x,np.where(x<=h1,m,m+(x-h1)*(1-m)/(1-h1)))
    return mod4_half(xa,t,I,m)
def half(name,x):
    if name=='BODY': return body_half(x)
    if '-' in name:                       # '0016-64'
        a,b=name.split('-'); return mod4_half(x,int(a[2:])/100,int(b[0]),int(b[1])/10)
    return naca4_half(x,int(name[2:])/100)
def coords(name,n=81):
    """замкнений контур: верх від TE до LE, низ від LE до TE (cos-розподіл)"""
    b=np.linspace(0,np.pi,n); x=0.5*(1-np.cos(b)); y=half(name,x)
    xs=np.r_[x[::-1],x[1:]]; ys=np.r_[y[::-1],-y[1:]]
    return xs,ys
"""Геометрія РОМБ D5 як набори точок (без CAD): спільна для build123d і FreeCAD."""
import numpy as np
def smooth(t): t=np.clip(t,0,1); return t*t*(3-2*t)
# ---------- гладка поверхня крила ----------
# передня кромка — ламана через станції з заокругленими зламами; задня — пряма; товщина між станціями —
# монотонний кубічний сплайн (PCHIP) по y для кожної точки хорди. Поверхня — гладкий loft через N_SPAN перерізів.
_XC=0.5*(1-np.cos(np.linspace(0,np.pi,N_PTS)))
_SY=np.array([s[0] for s in SECTIONS])
_SH=np.array([half(s[1],_XC)*1.0 for s in SECTIONS])      # напівтовщина / хорда в точках _XC
def _pchip_slopes(x,y):
    h=np.diff(x); d=np.diff(y,axis=0)/h[:,None]; m=np.zeros_like(y)
    for k in range(1,len(x)-1):
        w1=2*h[k]+h[k-1]; w2=h[k]+2*h[k-1]
        same=(d[k-1]*d[k])>0
        m[k]=np.where(same,(w1+w2)/(w1/np.where(same,d[k-1],1)+w2/np.where(same,d[k],1)),0)
    m[0]=d[0]; m[-1]=d[-1]
    return m
_SM=_pchip_slopes(_SY,_SH)
def _hcol(y):
    """напівтовщина/хорда в точках _XC на розмаху y (PCHIP)"""
    y=min(abs(y),_SY[-1]); k=int(np.clip(np.searchsorted(_SY,y)-1,0,len(_SY)-2))
    h=_SY[k+1]-_SY[k]; t=(y-_SY[k])/h
    h00=2*t**3-3*t**2+1; h10=t**3-2*t**2+t; h01=-2*t**3+3*t**2; h11=t**3-t**2
    return h00*_SH[k]+h10*h*_SM[k]+h01*_SH[k+1]+h11*h*_SM[k+1]
def le_x(y):
    """передня кромка: ламана через станції, злами заокруглені квадратичною кривою Безьє"""
    y=abs(y); P=[(s[0],s[3]) for s in SECTIONS]
    for i in range(1,len(P)-1):
        yc,xc=P[i]; b=LE_BLEND.get(yc,0)
        if b>0 and abs(y-yc)<b:
            (y0,x0),(y2,x2)=P[i-1],P[i+1]
            ya,xa=yc-b,xc+(x0-xc)*b/(yc-y0); yb,xb=yc+b,xc+(x2-xc)*b/(y2-yc)
            # параметр Безьє t по y (квадратне рівняння)
            A=ya-2*yc+yb; B=2*(yc-ya); C=ya-y
            t=(-C/B) if abs(A)<1e-9 else (-B+np.sqrt(max(B*B-4*A*C,0)))/(2*A)
            return float((1-t)**2*xa+2*(1-t)*t*xc+t*t*xb)
    return float(np.interp(y,[p[0] for p in P],[p[1] for p in P]))
def te_x(y): return TE_ROOT-abs(y)*np.tan(np.radians(TE_FWD_SWEEP))
def chord(y): return te_x(y)-le_x(y)
def span_stations():
    u=np.linspace(0,1,N_SPAN); ys=SPAN_HALF*(1-np.cos(u*np.pi/2))**1.0   # густіше біля кореня
    return ys
def full_sections():
    ys=span_stations(); return [-y for y in ys[::-1] if y>0]+list(ys)
def section_pts(y,*_):
    c=chord(y); le=le_x(y); h=_hcol(y)
    xs=np.r_[_XC[::-1],_XC[1:]]; zs=np.r_[h[::-1],-h[1:]]
    return np.c_[le+c*xs, np.full_like(xs,y), c*zs]
def z_top(x,y):
    y=abs(y)
    if y>SPAN_HALF: return 0.0
    le=le_x(y); c=chord(y); u=(x-le)/c
    if u<0 or u>1: return 0.0
    return float(c*np.interp(u,_XC,_hcol(y)))
def body_le_y(x):
    ys=np.linspace(0,SPAN_HALF,4001); xs=np.array([le_x(y) for y in ys])
    return float(np.interp(x,xs,ys))
# ---------- NACA 1-series (NASA TM X-3324, табл. I; пропущені рядки інтерпольовані) ----------
_N1=np.array([(0,0),(0.2,4.80),(0.4,6.63),(0.6,8.12),(0.8,9.33),(1,10.38),(1.5,12.72),(2,14.72),
 (4.5,22.96),(5,24.36),(6,27.01),(7,29.47),(8,31.81),(9,34.03),(10,36.13),(11,38.15),(12,40.09),(13,41.94),
 (20,52.70),(21,54.05),(22,55.37),(23,56.66),(24,57.92),(25,59.15),(26,60.35),(27,61.52),(28,62.67),(29,63.79),
 (30,64.89),(31,65.97),(32,67.03),(33,68.07),(34,69.08),(35,70.08),(36,71.05),(37,72.00),(38,72.94),(39,73.85),
 (40,74.75),(41,75.63),(48,81.25),(49,81.99),(50,82.69),(52,84.10),(54,85.45),(56,86.73),(58,87.95),(60,89.11),
 (62,90.20),(64,91.23),(66,92.20),(68,93.11),(70,93.95),(72,94.75),(74,95.48),(76,96.16),(78,96.79),(80,97.35),
 (82,97.87),(84,98.33),(86,98.74),(88,99.09),(90,99.40),(100,100.0)])/100
def naca1(u):
    """y/Y як функція x/X (0..1); інтерполяція в координатах sqrt для гладкості біля носика"""
    u=np.clip(u,0,1); return np.interp(np.sqrt(u),np.sqrt(_N1[:,0]),_N1[:,1])
# ---------- контури ----------
def _resample(P,n):
    Q=np.r_[P,P[:1]]; d=np.r_[0,np.cumsum(np.hypot(*np.diff(Q,axis=0).T))]
    s=np.linspace(0,d[-1],n,endpoint=False)
    return np.c_[np.interp(s,d,Q[:,0]),np.interp(s,d,Q[:,1])]
def rrect(w,h,r,n=72):
    """закруглений прямокутник з центром (0,0), старт (w/2,0), проти год. стрілки"""
    r=min(r,w/2-1e-3,h/2-1e-3); hw,hh=w/2-r,h/2-r; P=[]
    for cx,cz,a0 in ((hw,hh,0),(-hw,hh,np.pi/2),(-hw,-hh,np.pi),(hw,-hh,1.5*np.pi)):
        a=np.linspace(a0,a0+np.pi/2,12); P.append(np.c_[cx+r*np.cos(a),cz+r*np.sin(a)])
    P=np.vstack(P); P=_resample(P,4*n)
    i=np.argmin(np.abs(P[:,1])+(P[:,0]<0)*1e3); return _resample(np.roll(P,-i,axis=0),n)
def dshape(r,split,n=72):
    """половина кола (опукла в +y), плоска сторона на y=split; старт (split+r,0)"""
    a=np.linspace(-np.pi/2,np.pi/2,60); arc=np.c_[split+r*np.cos(a),r*np.sin(a)]
    flat=np.linspace([split,r],[split,-r],30)[1:-1]; P=np.r_[arc,flat]
    i=np.argmin(np.abs(P[:,1])+(P[:,0]<split+r/2)*1e3); return _resample(np.roll(P,-i,axis=0),n)
def area(P): y,z=P[:,0],P[:,1]; return 0.5*abs(np.dot(y,np.roll(z,1))-np.dot(z,np.roll(y,1)))
def rr_dims(A,ar,rf=0.45):
    """w,h,r закругленого прямокутника площею A, h/w=ar, r=rf*w"""
    w=np.sqrt(A/(ar-(4-np.pi)*rf*rf)); return w,ar*w,rf*w
# ---------- повітрозабірник у товщині крила і канал ----------
def _lens(x,y0,y1,d,n=72):
    """переріз крила площиною x між y0 і y1, зміщений усередину на d (d<0 — назовні); старт — зовнішній кінчик, проти год. стрілки"""
    ys=np.linspace(y0,y1,240); h=np.array([z_top(x,y)-d for y in ys])
    ok=h>0.3; ys,h=ys[ok],h[ok]
    top=np.c_[ys[::-1],h[::-1]]; bot=np.c_[ys,-h]
    P=np.r_[bot,top]                       # від внутр-низу → зовн. кінчик → верх → внутр-верх
    P=_resample(P,4*n); i=np.argmax(P[:,0]-1e-3*np.abs(P[:,1]))
    return _resample(np.roll(P,-i,axis=0),n)
def _inlet_y():
    """внутрішній край входу підбирається так, щоб площа входу = A_THROAT*INLET_CR"""
    yout=body_le_y(X_INLET)-INLET_EDGE; lo,hi=0.0,yout-5
    for _ in range(40):
        yin=(lo+hi)/2; A=area(_lens(X_INLET,yin+LIP_T,yout,LIP_T))
        if A<A_THROAT*INLET_CR: hi=yin
        else: lo=yin
    return (lo+hi)/2,yout
Y_INLET_IN,Y_INLET_OUT=_inlet_y()
MOUTH=_lens(X_INLET,Y_INLET_IN+LIP_T,Y_INLET_OUT,LIP_T)
YC0=float(np.mean(MOUTH[:,0])); A_MOUTH=area(MOUTH)
def notch_box():
    """усе, що перед заокругленням губи в смузі входу, прибирається (виїмка в кромці)"""
    return (le_x(Y_INLET_IN)-30, X_INLET-LIP_R+2, Y_INLET_IN-1.0, Y_INLET_OUT+40)
def flare_sections(side=1,n=7):
    out=[]
    for u in np.linspace(0,1,n):
        x=X_INLET-LIP_R*(1-u); d=-1.5+(LIP_T+1.5)*np.sqrt(1-(1-u)**2)
        P=_lens(x,Y_INLET_IN+d,Y_INLET_OUT+(6 if d<0 else 0),d)   # внутрішня губа теж заокруглена
        out.append(np.c_[np.full(len(P),x),side*P[:,0],P[:,1]])
    return out
def duct_center(x):
    t=smooth((x-X_INLET-L_INLIP)/(X_DUCT2-X_INLET-L_INLIP)); return (1-t)*YC0+t*DUCT_Y_END, t
def duct_area_at(x):
    if x<=X_INLET: return A_MOUTH
    if x<=X_INLET+L_INLIP:
        u=(x-X_INLET)/L_INLIP; k=1-np.sqrt(1-(1-u)**2)
        return A_THROAT+(A_MOUTH-A_THROAT)*k
    u=(x-X_INLET-L_INLIP)/(X_DUCT2-X_INLET-L_INLIP)
    return A_THROAT+(A_DUCT_END-A_THROAT)*u
_M0=MOUTH-[YC0,0]
def duct_section(x,side=1):
    yc,t=duct_center(x); A=duct_area_at(x)
    w,h,r=rr_dims(A_MOUTH,1.0); C=rrect(w,h,r)
    P=(1-t)*_M0+t*C; P=P*np.sqrt(A/area(P))+[yc,0]
    return np.c_[np.full(len(P),x),side*P[:,0],P[:,1]]
def duct_sections(side=1):
    # перший переріз трохи менший за кінець заокруглення губи (сходинка ≈0,7 мм) — щоб поверхні не збігались
    first=_M0*0.975+[YC0,0]; first=np.c_[np.full(len(first),X_INLET-1.0),side*first[:,0],first[:,1]]
    xs=np.linspace(X_INLET+4,X_DUCT2,N_DUCT)
    return [first]+[duct_section(x,side) for x in xs]
def duct_shape(x):
    s=duct_section(x); return s[:,1].mean(),0,s[:,1].max()-s[:,1].min(),2*s[:,2].max(),0
# ---------- двигун і відсік ----------
def engine_profile():
    return [(X_NOZZLE+(xl-9.95)*10,r) for xl,r in ENGINE]
def bay_profile():
    """камера перед двигуном (обидва канали) + огинаюча двигуна з зазором + канал вихлопу"""
    E=engine_profile(); rmax=max(r for x,r in E); gp=BAY_GAP
    xs=[x for x,r in E if r>=rmax-1]; x_case0,x_case1=xs[0],xs[-1]
    x_noz,r_noz=E[-2]
    dome=[(X_CH0,0.5),(X_CH0,R_CH*0.45),(X_CH0+6,R_CH*0.75),(X_CH0+16,R_CH*0.93),(X_CH0+30,R_CH)]
    return dome+[(x_case0,max(R_CH,rmax+gp)),(x_case1+5,rmax+gp),(x_noz,r_noz+gp),(X_EXHAUST,r_noz+gp)]
# ---------------- побудова у FreeCAD ----------------
import FreeCAD as App, Part, math
V=App.Vector
def _w_open(P):
    pts=[V(*map(float,p)) for p in P]; bs=Part.BSplineCurve(); bs.interpolate(pts)
    return Part.Wire([bs.toShape(),Part.LineSegment(pts[-1],pts[0]).toShape()])
def _w_closed(P):
    pts=[V(*map(float,p)) for p in P]; bs=Part.BSplineCurve(); bs.interpolate(pts,PeriodicFlag=True)
    return Part.Wire([bs.toShape()])
def _rev_x(prof):
    poly=[V(prof[0][0],0,0)]+[V(x,0,r) for x,r in prof]+[V(prof[-1][0],0,0),V(prof[0][0],0,0)]
    return Part.Face(Part.makePolygon(poly)).revolve(V(0,0,0),V(1,0,0),360)
def _box(x0,x1,y0,y1,z0=-200,z1=200): return Part.makeBox(x1-x0,y1-y0,z1-z0,V(x0,y0,z0))
def build(docname='ROMB_D5_jet200', structure=True):
    if docname in App.listDocuments(): App.closeDocument(docname)
    doc=App.newDocument(docname)
    W=Part.makeLoft([_w_open(section_pts(s)) for s in full_sections()],True,False)
    ducts=[Part.makeLoft([_w_closed(s) for s in duct_sections(sd)],True,False) for sd in (1,-1)]
    flares=[Part.makeLoft([_w_closed(s) for s in flare_sections(sd)],True,False) for sd in (1,-1)]
    bay=_rev_x(bay_profile())
    x0,x1,y0,y1=notch_box()
    W=W.cut(_box(x0,x1,y0,y1)).cut(_box(x0,x1,-y1,-y0))
    for c in flares+ducts: W=W.cut(c)
    W=W.cut(bay)
    B=W
    yi,ys,ss=Y_ELEV_IN,Y_ELEV_SPLIT,FIN_STRIP
    B=B.cut(_box(X_HINGE,X_HINGE+HINGE_GAP,yi,SPAN_HALF+5)).cut(_box(X_HINGE,X_HINGE+HINGE_GAP,-SPAN_HALF-5,-yi))
    parts=[]
    for nm,y0,y1 in (('Elevon_in_R',yi,ys-ss),('Elevon_out_R',ys+ss,SPAN_HALF+5),
                     ('Elevon_in_L',-ys+ss,-yi),('Elevon_out_L',-SPAN_HALF-5,-ys-ss)):
        b=_box(X_HINGE+HINGE_GAP,X_HINGE+200,y0,y1); parts.append((nm,B.common(b))); B=B.cut(b)
    parts=[('Body',B)]+parts
    for side,nm in ((1,'Fin_R'),(-1,'Fin_L')):
        xs,zs=coords(FIN_FOIL,41)
        w=lambda z,le,c:_w_open([(le+c*x,FIN_Y*side+c*t,z) for x,t in zip(xs,zs)])
        s=Part.makeLoft([w(0,FIN_ROOT_LE,FIN_ROOT_C),w(FIN_SPAN,FIN_ROOT_LE+FIN_TIP_DX,FIN_TIP_C)],True,True)
        s.rotate(V(0,FIN_Y*side,0),V(1,0,0),-FIN_CANT*side); parts.append((nm,s))
    parts.append(('Engine_jet200',_rev_x(engine_profile())))
    S=[]
    if structure:
        t=T_PLATE/2
        S.append(('Keel',B.common(_box(KEEL[0],KEEL[1],-t,t))))
        for sd,n in ((1,'R'),(-1,'L')):
            y=sd*SIDE_WEBS[0]; S.append(('Web_'+n,B.common(_box(SIDE_WEBS[1],SIDE_WEBS[2],y-t,y+t))))
        for x,hw in FRAMES: S.append((f'Frame_{int(x)}',B.common(_box(x-t,x+t,-hw,hw))))
        (ya,xa),(yb,xb)=FRONT_SPAR; ang=math.degrees(math.atan2(xb-xa,yb-ya)); L=math.hypot(xb-xa,yb-ya)
        for sd,n in ((1,'R'),(-1,'L')):
            sp=Part.makeBox(T_PLATE,L,400,V(-t,0,-200)); sp.rotate(V(0,0,0),V(0,0,1),-sd*ang if sd>0 else 0)
            if sd<0: sp=Part.makeBox(T_PLATE,L,400,V(-t,-L,-200)); sp.rotate(V(0,0,0),V(0,0,1),ang)
            sp.translate(V(xa,sd*ya,0)); S.append(('Spar_front_'+n,B.common(sp)))
            S.append(('Spar_rear_'+n,B.common(_box(REAR_SPAR[0]-t,REAR_SPAR[0]+t,*sorted((sd*REAR_SPAR[1],sd*REAR_SPAR[2]))))))
            for yr in RIBS:
                xf=xa+(yr-ya)*(xb-xa)/(yb-ya) if yr>=ya else le_x(yr)+35
                S.append((f'Rib_{int(yr)}_{n}',B.common(_box(xf-2,REAR_SPAR[0],sd*yr-t,sd*yr+t))))
            for k,(ysv,xsv) in enumerate(SERVOS):
                lx,ly,lz=SERVO_BOX; S.append((f'Servo_{k}_{n}',_box(xsv-lx/2,xsv+lx/2,sd*ysv-ly/2,sd*ysv+ly/2,-lz/2,lz/2)))
            for y0,y1 in ((yi,ys-ss),(ys+ss,SPAN_HALF)):
                a,b2=sorted((sd*y0,sd*y1))
                S.append((f'Hinge_{int(y0)}_{n}',Part.makeCylinder(1.0,b2-a,V(X_HINGE+0.5,a,0),V(0,1,0))))
    col={'Body':(0.72,0.77,0.82),'Elev':(0.89,0.63,0.24),'Fin_':(0.35,0.56,0.82),'Engi':(0.75,0.22,0.17),
         'Serv':(0.17,0.24,0.31),'Hing':(0.5,0.55,0.55)}
    grp=doc.addObject('App::DocumentObjectGroup','Structure') if S else None
    for nm,sh in parts+S:
        o=doc.addObject('Part::Feature',nm); o.Shape=sh
        if grp and (nm,sh) in S: grp.addObject(o)
        if App.GuiUp: o.ViewObject.ShapeColor=col.get(nm[:4],(0.15,0.68,0.38))
    doc.recompute()
    if App.GuiUp:
        import FreeCADGui as Gui; Gui.ActiveDocument.ActiveView.viewIsometric(); Gui.SendMsgToActiveView('ViewFit')
    for nm,sh in parts: print(f'{nm:14s} V={sh.Volume/1e6:7.3f} L valid={sh.isValid()}')
    return doc
if __name__=='__main__': build()
