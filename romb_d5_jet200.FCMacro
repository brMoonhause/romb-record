# ROMB D5 / jet 200 — параметрична модель для FreeCAD (Macro > Macros... > Execute). Згенеровано з params.py + foils.py + geom.py + fc_build.py
"""РОМБ D5 / jet 200 — таблиця параметрів (мм). Правиш тут — модель перебудовується."""
# --- планформа (контрольні лінії) ---
LE_SWEEP_IN  = 78.0    # град, передня кромка до злому
X_CRANK      = 600.0   # x злому передньої кромки
LE_SWEEP_OUT = 40.0    # град, після злому
TE_ROOT      = 1000.0  # x задньої кромки на осі
TE_FWD_SWEEP = 10.0    # град, задня кромка стріловидна вперед
SPAN_HALF    = 400.0
# --- перерізи: (y, профіль, хорда, зміщення LE)  профілі: BODY, 0016-64, 0012-64, 0009, 0006 ---
SECTIONS = [
    (0.0,   'BODY',    1000.0,   0.0),   # повний профіль тіла, ззаду обрізається нішею на X_SLOT
    (30.0,  'BODY',     926.7,  53.0),   # = BODY-150-T72 хорда 670 / 0.723
    (60.0,  '0016-64',  707.1, 282.3),   # біля стінки ніші (було y=66)
    (80.0,  '0016-64',  569.0, 417.0),
    (127.5, '0012-64',  378.0, 600.0),
    (200.0, '0009',     304.0, 661.0),
    (340.0, '0006',     162.0, 778.0),
    (400.0, '0006',     101.0, 829.0),
]
# --- ніша двигуна ---
Y_SLOT      = 59.0     # напівширина ніші (корпус Ø109 + 4,5 мм зазор)
# --- обтічник: тіло плавно звужується від X_FAIR0 до кола навколо входу двигуна ---
X_FAIR0     = 680.0    # початок обтічника
X_FAIR1     = 806.0    # кінець обтічника = початок ніші (корпус двигуна вже Ø107)
R_FAIR1     = 57.0     # зовнішній радіус кінця обтічника (корпус двигуна r 54,5 + стінка)
X_COWL_END  = 850.0    # обтічник продовжується циліндричним кільцем-капотом навколо передньої частини двигуна
N_FAIR      = 7        # проміжних перерізів обтічника
# --- повітрозабірники (2 шт, зрізані по передній кромці між тілом і крилом) + S-канали ---
INLET_Y_IN  = 54.0     # внутрішня стінка каналу біля входу
INLET_Y_OUT = 80.0     # зовнішня стінка (точка злому передньої кромки y=80)
INLET_H     = 60.0     # висота каналу біля входу
INLET_R     = 8.0      # радіус кутів
X_DUCT0     = 240.0    # початок каналу (перед передньою кромкою — звідси зріз входу)
X_DUCT1     = 450.0    # кінець прямої ділянки, далі S-вигин до двигуна
X_DUCT2     = 745.0    # кінець каналу: вихід у камеру перед двигуном
DUCT_R_END  = 38.0     # кожен канал закінчується половиною кола r38 (разом ≈ коло Ø76)
DUCT_SPLIT  = 1.0      # півтовщини перегородки між каналами на осі
DUCT_WALL   = 4.0      # мінімальна товщина стінки каналу до зовнішньої поверхні
N_DUCT      = 21       # перерізів каналу (рівномірно)
# --- камера перед двигуном (виріз в обтічнику під губу і купол двигуна) ---
PLENUM = [(740.0,43.0),(786.0,43.0),(789.5,48.0),(794.0,52.0),(801.0,54.8),(807.0,55.5),(851.0,55.5)]   # (x, r)
# --- двигун jet 200 (профіль з його моделі Fusion), сопло на X_NOZZLE ---
X_NOZZLE    = 985.0
ENGINE = [(-14.15,2),(-11.75,12.5),(-10.75,12.5),(-10.75,42.1),(-9.95,42.1),(-9.6,47),(-9.1,51),
          (-8.45,53.5),(-3.65,54.5),(2.75,54.5),(4.75,53.5),(5.65,46),(5.8,38),(7.25,36.5),(9.95,27),(9.95,0.5)]
            # (x у см у системі моделі двигуна, r у мм); зріз сопла x=9.95
# --- елевони ---
X_HINGE     = 890.0
Y_ELEV_IN   = 72.0     # внутрішній край (бокова стінка на y=70)
Y_ELEV_SPLIT= 200.0
# --- кілі ---
FIN_Y       = 200.0
FIN_ROOT_LE = 765.0
FIN_ROOT_C  = 200.0
FIN_TIP_C   = 110.0
FIN_TIP_DX  = 70.0     # зсув LE на кінці
FIN_SPAN    = 90.0     # від площини крила (z=0) до кінця; відкрита висота ~80
FIN_CANT    = 5.0      # град назовні
FIN_FOIL    = '0005'
N_PTS       = 81       # точок на поверхню профілю
"""Профілі: NACA 4-digit і modified 4-digit (00tt-IT), та профіль тіла BODY-150."""
import numpy as np
D1={0.2:0.200,0.3:0.234,0.4:0.315,0.5:0.465,0.6:0.700}
def mod4_half(x,t,I,m):
    """напівтовщина modified NACA 4-digit (Ladson, NASA TM-4741), хорда 1"""
    d0=0.002; d1=D1[m]; sm=1-m
    A=np.array([[sm**2,sm**3],[2*sm,3*sm**2]]); d2,d3=np.linalg.solve(A,[0.1-d0-d1*sm,-d1])
    fpp=2*d2+6*d3*sm                       # f'' по x у точці m
    a0=0.296904*I/6
    M=np.array([[m,m*m,m**3],[1,2*m,3*m*m],[0,2,6*m]])
    rhs=[0.1-a0*np.sqrt(m),-0.5*a0/np.sqrt(m),fpp+0.25*a0*m**-1.5]
    a1,a2,a3=np.linalg.solve(M,rhs)
    x=np.asarray(x,float); y=np.where(x<m,a0*np.sqrt(x)+a1*x+a2*x**2+a3*x**3,
        d0+d1*(1-x)+d2*(1-x)**2+d3*(1-x)**3)
    return y*t/0.2
def naca4_half(x,t):
    x=np.asarray(x,float)
    return 5*t*(0.2969*np.sqrt(x)-0.1260*x-0.3516*x**2+0.2843*x**3-0.1015*x**4)
def body_half(x,t=0.15,I=6,m=0.5,hold=(0.50,0.65)):
    """BODY-150: mod4 0.15 I=6 T=0.5, плоска ділянка максимальної товщини від 0.50 до 0.65,
    задня частина стиснута на [0.65,1]"""
    x=np.asarray(x,float); h0,h1=hold
    xa=np.where(x<=h0,x,np.where(x<=h1,m,m+(x-h1)*(1-m)/(1-h1)))
    return mod4_half(xa,t,I,m)
def half(name,x):
    if name=='BODY': return body_half(x)
    if '-' in name:                       # '0016-64'
        a,b=name.split('-'); return mod4_half(x,int(a[2:])/100,int(b[0]),int(b[1])/10)
    return naca4_half(x,int(name[2:])/100)
def coords(name,n=81):
    """замкнений контур: верх від TE до LE, низ від LE до TE (cos-розподіл)"""
    b=np.linspace(0,np.pi,n); x=0.5*(1-np.cos(b)); y=half(name,x)
    xs=np.r_[x[::-1],x[1:]]; ys=np.r_[y[::-1],-y[1:]]
    return xs,ys
"""Геометрія РОМБ D5 як набори точок (без CAD): спільна для build123d і FreeCAD."""
import numpy as np
def smooth(t): t=np.clip(t,0,1); return t*t*(3-2*t)
# ---------- перерізи крила ----------
def full_sections():
    return [(-y,f,c,o) for y,f,c,o in SECTIONS[::-1] if y>0]+SECTIONS
def section_pts(y,foil,c,off,n=None):
    xs,zs=coords(foil,n or N_PTS); return np.c_[off+c*xs, np.full_like(xs,y), c*zs]
# ---------- верхня поверхня крила z(x,y) (лінійчата між станціями, як і loft) ----------
_ST=[(y,section_pts(y,f,c,o)) for y,f,c,o in SECTIONS]
def z_top(x,y):
    y=abs(y)
    for (ya,A),(yb,B) in zip(_ST[:-1],_ST[1:]):
        if ya<=y<=yb:
            t=(y-ya)/(yb-ya); n=(len(A)+1)//2
            P=A[:n]*(1-t)+B[:n]*t          # верхня половина (від TE до LE)
            xs,zs=P[::-1,0],P[::-1,2]      # LE -> TE
            if x<xs[0] or x>xs[-1]: return 0.0
            return float(np.interp(x,xs,zs))
    return 0.0
# ---------- обтічник ----------
def _ring(pts_yz,n=72):
    """перевибірка замкненого контуру за кутом навколо (0,0)"""
    a=np.arctan2(pts_yz[:,1],pts_yz[:,0]); o=np.argsort(a); a,P=a[o],pts_yz[o]
    A=np.linspace(-np.pi,np.pi,n,endpoint=False)
    r=np.hypot(P[:,0],P[:,1]); rr=np.interp(A,a,r,period=2*np.pi)
    return np.c_[rr*np.cos(A),rr*np.sin(A)]
def body_section_yz(x,ymax=Y_SLOT+0.5,n=81,rc=6.0):
    """переріз тіла площиною x=const для |y|<=ymax, кути біля стінок ніші заокруглені rc"""
    ys=ymax*np.sin(np.linspace(-np.pi/2,np.pi/2,n))          # густіше біля боків
    zt=np.array([z_top(x,y) for y in ys])
    # заокруглення кутів: біля |y|=ymax верхня лінія плавно опускається на rc
    d=ymax-np.abs(ys); zt=np.where(d<rc, zt-rc+np.sqrt(np.clip(rc*rc-(rc-d)**2,0,None)), zt)
    top=np.c_[ys,zt][::-1]                                   # від +y до -y по верху
    bot=np.c_[ys,-zt]                                        # від -y до +y по низу
    P=np.r_[top,bot[1:-1]]
    return P
def fairing_sections(n=160):
    A=_resample(body_section_yz(X_FAIR0),n)
    i0=np.argmin(np.abs(np.arctan2(A[:,1],A[:,0]))); A=np.roll(A,-i0,axis=0)   # старт на +y, z=0
    ang=np.unwrap(np.arctan2(A[:,1],A[:,0]))
    C=np.c_[R_FAIR1*np.cos(ang),R_FAIR1*np.sin(ang)]
    out=[]
    for i in range(N_FAIR+2):
        t=i/(N_FAIR+1); x=X_FAIR0+t*(X_FAIR1-X_FAIR0); w=smooth(t)
        P=(1-w)*A+w*C; out.append(np.c_[np.full(len(P),x),P[:,0],P[:,1]])
    return out
# ---------- канали ----------
def _rrect(yc,w,h,r,n=64):
    """закруглений прямокутник, точки рівномірно по периметру, старт з (yc+w/2, 0) проти год. стрілки"""
    from math import pi
    hw,hh=w/2-r,h/2-r
    segs=[('L',(hw+r, -hh),(hw+r,hh)),('A',(hw,hh),0),('L',(hw,hh+r),(-hw,hh+r)),('A',(-hw,hh),pi/2),
          ('L',(-hw-r,hh),(-hw-r,-hh)),('A',(-hw,-hh),pi),('L',(-hw,-hh-r),(hw,-hh-r)),('A',(hw,-hh),1.5*pi)]
    pts=[]
    for s in segs:
        if s[0]=='L':
            p=np.linspace(s[1],s[2],40,endpoint=False)
        else:
            a=np.linspace(s[2],s[2]+pi/2,20,endpoint=False); p=np.c_[s[1][0]+r*np.cos(a),s[1][1]+r*np.sin(a)]
        pts.append(p)
    P=np.vstack(pts); P=P[np.r_[len(P)//2*0:len(P)]]
    # старт з середини правої сторони
    P=np.roll(P,-20,axis=0)
    return _resample(P+[yc,0],n)
def _dshape(r,split,n=64):
    """половина кола, плоска сторона на y=split, опукла назовні (+y)"""
    a=np.linspace(-np.pi/2,np.pi/2,60); arc=np.c_[split+r*np.cos(a),r*np.sin(a)]
    flat=np.linspace([split,r],[split,-r],30)[1:-1]
    P=np.r_[arc,flat]; i=np.argmin(np.abs(P[:,1])+ (P[:,0]<split+r/2)*1e3)
    return _resample(np.roll(P,-i,axis=0),n)
def _resample(P,n):
    Q=np.r_[P,P[:1]]; d=np.r_[0,np.cumsum(np.hypot(*np.diff(Q,axis=0).T))]
    s=np.linspace(0,d[-1],n,endpoint=False)
    return np.c_[np.interp(s,d,Q[:,0]),np.interp(s,d,Q[:,1])]
def duct_sections(side=1):
    R=_rrect(0,INLET_Y_OUT-INLET_Y_IN,INLET_H,INLET_R); D=_dshape(DUCT_R_END,DUCT_SPLIT)
    yc0=(INLET_Y_IN+INLET_Y_OUT)/2
    xs=np.linspace(X_DUCT0,X_DUCT2,N_DUCT)      # рівномірно — інакше loft «роздуває» канал
    out=[]
    for x in xs:
        t=smooth((x-X_DUCT1)/(X_DUCT2-X_DUCT1))
        P=(1-t)*(R+[yc0,0])+t*D
        out.append(np.c_[np.full(len(P),x),side*P[:,0],P[:,1]])
    return out
def duct_area(sec): y,z=sec[:,1],sec[:,2]; return 0.5*abs(np.dot(y,np.roll(z,1))-np.dot(z,np.roll(y,1)))
def engine_profile():
    return [(X_NOZZLE+(xl-9.95)*10,r) for xl,r in ENGINE]
# ---------------- побудова у FreeCAD ----------------
import FreeCAD as App, Part
V=App.Vector
def _w_open(P):
    pts=[V(*map(float,p)) for p in P]; bs=Part.BSplineCurve(); bs.interpolate(pts)
    return Part.Wire([bs.toShape(),Part.LineSegment(pts[-1],pts[0]).toShape()])
def _w_closed(P):
    pts=[V(*map(float,p)) for p in P]; bs=Part.BSplineCurve(); bs.interpolate(pts,PeriodicFlag=True)
    return Part.Wire([bs.toShape()])
def _rev_x(prof):
    poly=[V(prof[0][0],0,0)]+[V(x,0,r) for x,r in prof]+[V(prof[-1][0],0,0),V(prof[0][0],0,0)]
    return Part.Face(Part.makePolygon(poly)).revolve(V(0,0,0),V(1,0,0),360)
def build(docname='ROMB_D5_jet200'):
    if docname in App.listDocuments(): App.closeDocument(docname)
    doc=App.newDocument(docname)
    W=Part.makeLoft([_w_open(section_pts(*s)) for s in full_sections()],True,True)
    W=W.cut(Part.makeBox(600,2*Y_SLOT,400,V(X_FAIR0,-Y_SLOT,-200)))
    F=Part.makeLoft([_w_closed(s) for s in fairing_sections()],True,False)
    cowl=Part.makeCylinder(R_FAIR1,X_COWL_END-X_FAIR1,V(X_FAIR1,0,0),V(1,0,0))
    ducts=[Part.makeLoft([_w_closed(s) for s in duct_sections(side)],True,False) for side in (1,-1)]
    PL=_rev_x(PLENUM)
    # канали й камеру вирізаємо з кожної частини окремо, потім об'єднуємо (так стабільніше в OCC FreeCAD)
    for d in ducts: W=W.cut(d); F=F.cut(d)
    F=F.cut(PL); cowl=cowl.cut(PL)
    B=W.fuse(F).fuse(cowl)
    parts=[]
    for nm,y0,y1 in (('Elevon_in_R',Y_ELEV_IN,Y_ELEV_SPLIT),('Elevon_out_R',Y_ELEV_SPLIT,SPAN_HALF+5),
                     ('Elevon_in_L',-Y_ELEV_SPLIT,-Y_ELEV_IN),('Elevon_out_L',-SPAN_HALF-5,-Y_ELEV_SPLIT)):
        b=Part.makeBox(200,y1-y0,400,V(X_HINGE,y0,-200)); parts.append((nm,B.common(b))); B=B.cut(b)
    parts=[('Body',B)]+parts
    for side,nm in ((1,'Fin_R'),(-1,'Fin_L')):
        xs,zs=coords(FIN_FOIL,41)
        w=lambda z,le,c:_w_open([(le+c*x,FIN_Y*side+c*t,z) for x,t in zip(xs,zs)])
        s=Part.makeLoft([w(0,FIN_ROOT_LE,FIN_ROOT_C),w(FIN_SPAN,FIN_ROOT_LE+FIN_TIP_DX,FIN_TIP_C)],True,True)
        s.rotate(V(0,FIN_Y*side,0),V(1,0,0),-FIN_CANT*side); parts.append((nm,s))
    parts.append(('Engine_jet200',_rev_x(engine_profile())))
    col={'Body':(0.72,0.77,0.82),'Elev':(0.89,0.63,0.24),'Fin_':(0.35,0.56,0.82),'Engi':(0.75,0.22,0.17)}
    for nm,sh in parts:
        o=doc.addObject('Part::Feature',nm); o.Shape=sh
        if App.GuiUp: o.ViewObject.ShapeColor=col[nm[:4]]
    doc.recompute()
    if App.GuiUp:
        import FreeCADGui as Gui; Gui.ActiveDocument.ActiveView.viewIsometric(); Gui.SendMsgToActiveView('ViewFit')
    for nm,sh in parts: print(f'{nm:14s} V={sh.Volume/1e6:7.3f} L valid={sh.isValid()}')
    return doc
build()
